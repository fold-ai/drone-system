# Copy to .env.local for development. Never commit a filled-in copy.

# --- sessions --------------------------------------------------------------
# At least 32 characters. Rotating it signs everyone out, which is the point.
#   openssl rand -base64 48
SESSION_SECRET=

# --- database --------------------------------------------------------------
# Vercel Postgres sets POSTGRES_URL for you. Locally, point at anything.
POSTGRES_URL=postgres://localhost:5432/actprove

# --- first operator --------------------------------------------------------
# Read once by db/migrations/0002_seed_first_operator.mjs, then unset.
# There is no hardcoded password anywhere in the repository.
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=

# --- console gate ----------------------------------------------------------
# "path" gates /admin-pro. Switch to "host" and set CONSOLE_HOST to move the
# console to its own subdomain without touching middleware.ts.
CONSOLE_GATE_STRATEGY=path
CONSOLE_HOST=admin.actprove.com

# --- solver ----------------------------------------------------------------
ACT1_API_PORT=8787

# --- Interpretation (optional) ------------------------------------------
# Server-side only. Never referenced from a client component; the build is
# checked for it. Without a key the optimisation page works and simply offers
# no written commentary.
OPENAI_API_KEY=
# Defaults shown. Override the prices when the model or the tariff moves.
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=1400
OPENAI_MAX_COST_USD=0.25
OPENAI_PROMPT_PRICE=0.15
OPENAI_COMPLETION_PRICE=0.6
# Points the route at a compatible endpoint or a stub.
OPENAI_BASE_URL=https://api.openai.com/v1
