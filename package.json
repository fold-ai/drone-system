{
  "name": "actprove",
  "version": "1.0.0",
  "private": true,
  "description": "Actprove Defense Technologies: public site and the ACT-1 flight-test console",
  "scripts": {
    "dev": "concurrently -n api,web -c gray,white \"npm:dev:api\" \"next dev\"",
    "dev:api": "python3 scripts/dev_api.py",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "types": "python3 scripts/gen_types.py",
    "types:check": "python3 scripts/gen_types.py --check",
    "test": "python3 tests/test_physics.py",
    "checkpoint": "python3 scripts/checkpoint1.py",
    "migrate": "node db/migrate.mjs",
    "migrate:status": "node db/migrate.mjs --status",
    "db:smoke": "node db/smoke.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.12",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.185.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
